# ==========================================
# SAHAYA AI — Environment Configuration
# Copy this to .env or configure client and server .env files
# ==========================================

# BACKEND SERVER CONFIG
PORT=5000
NODE_ENV=development

# GOOGLE GEMINI AI CONFIG (Server Only - Never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# SUPABASE POSTGRESQL & AUTH CONFIG
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here # Server only if elevated privileges needed

# FRONTEND CLIENT CONFIG (Exposed to Vite bundle safely)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here
VITE_API_BASE_URL=http://localhost:5000/api
